

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Strike Ops - Legends Arena</title>
<style>
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;user-select:none}
html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#070a0e;color:#fff;font-family:Arial,sans-serif}
button{border:0;color:#fff;font-weight:800;border-radius:10px;padding:12px 16px;background:#e4a900}
.screen{position:absolute;inset:0;display:none}.screen.active{display:block}
#home{background:radial-gradient(circle at 60% 20%,#46525a,#172129 43%,#05070a 100%)}
.hero{position:absolute;inset:0;background:linear-gradient(90deg,#000d,transparent 55%,#000c)}
.brand{position:absolute;top:24px;left:24px;font-size:38px;font-weight:1000;font-style:italic}
.brand span{color:#f5b400}.sub{font-size:11px;color:#c8cdd1;letter-spacing:4px}
.top{position:absolute;right:18px;top:18px;display:flex;gap:8px}.pill{cursor:pointer;background:#111820dd;border:1px solid #46515e;border-radius:10px;padding:9px 12px}
.menu{position:absolute;left:24px;bottom:24px;width:min(410px,calc(100% - 48px));display:grid;gap:9px}
.menu button{min-height:48px;font-size:14px}.secondary{background:#202a33;border:1px solid #46525d}
#game{background:#34403f}#world{width:100%;height:100%;display:block;touch-action:none}
.hud{position:absolute;inset:0;pointer-events:none}.hud button,.joystick{pointer-events:auto}
.status,.score,.weapon,.mapname{position:absolute;background:#101820dd;border:1px solid #46525d;border-radius:10px}
.status{top:12px;left:12px;padding:8px 11px;font-size:12px}.mapname{top:52px;left:12px;padding:6px 10px;font-size:11px}
.score{top:12px;left:50%;transform:translateX(-50%);padding:7px 17px}.score b{font-size:21px;margin:0 8px}
.weapon{right:18px;bottom:145px;padding:9px 12px;text-align:right;font-weight:800}.ammo{color:#ffd34a}
.cross{position:absolute;left:50%;top:50%;width:26px;height:26px;transform:translate(-50%,-50%)}.cross:before,.cross:after{content:"";position:absolute;background:#fff}.cross:before{width:2px;height:26px;left:12px}.cross:after{height:2px;width:26px;top:12px}
.health{position:absolute;left:16px;bottom:18px;width:205px;height:22px;border:2px solid #fff;border-radius:8px;background:#222;overflow:hidden}.healthbar{height:100%;width:100%;background:#20c85b}.healthtext{position:absolute;inset:1px 0 0;text-align:center;font-size:12px;font-weight:900}
.joystick{position:absolute;left:22px;bottom:38px;width:120px;height:120px;border-radius:50%;border:2px solid #ffffff55;background:#ffffff10;touch-action:none}.knob{position:absolute;left:32px;top:32px;width:52px;height:52px;border-radius:50%;background:#ffffff55}
.fire{position:absolute;right:24px;bottom:34px;width:82px;height:82px;border-radius:50%;background:#d7422e;border:3px solid #fff}.reload,.switch{position:absolute;width:60px;height:60px;border-radius:50%;background:#202a34dd}.reload{right:122px;bottom:40px}.switch{right:194px;bottom:83px}
.modal{position:absolute;inset:0;background:#000b;display:none;align-items:center;justify-content:center;padding:20px}.modal.show{display:flex}
.panel{width:min(470px,100%);max-height:90vh;overflow:auto;background:#111820;border:1px solid #4b5761;border-radius:15px;padding:20px;text-align:center}.panel .card{background:#1c2730;border:1px solid #394650;border-radius:10px;padding:14px;margin:8px 0;text-align:left}.panel button{margin-top:8px}
.mapgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.mapcard{padding:13px;background:#1c2730;border:1px solid #46525d;border-radius:10px;cursor:pointer}.mapcard.active{border-color:#f1b400;box-shadow:0 0 0 1px #f1b400 inset}.mapcard b{display:block;margin-bottom:5px}.small{font-size:11px;color:#bfc5ca}
.aiming .cross{width:18px;height:18px}.aiming .cross:before{height:18px;left:8px}.aiming .cross:after{width:18px;top:8px}
body.lowgfx .smallfx{display:none}
.settings-row{display:flex;justify-content:space-between;align-items:center;background:#1c2730;border:1px solid #394650;border-radius:10px;padding:12px;margin:8px 0}
.settings-row select,.settings-row button{padding:8px;border-radius:8px;background:#2b3740;color:#fff;border:1px solid #55626d}
.skin-dot{display:inline-block;width:14px;height:14px;border-radius:50%;margin-right:7px;border:1px solid #fff}
.landingOverlay{position:absolute;inset:0;background:linear-gradient(#07111ccc,#07111c55 55%,#0008);display:none;align-items:center;justify-content:center;flex-direction:column;gap:10px;text-align:center;z-index:20;pointer-events:auto}.landingOverlay.show{display:flex}.plane{font-size:76px;animation:fly 1.5s ease-in-out infinite alternate}.landingTitle{font-size:28px;font-weight:1000;letter-spacing:3px}.landingText{color:#d6dde1}.landingOverlay button{margin-top:8px;padding:14px 24px}@keyframes fly{from{transform:translateX(-18px) rotate(-3deg)}to{transform:translateX(18px) rotate(3deg)}}
.muzzle{position:absolute;left:50%;top:50%;font-size:36px;transform:translate(-50%,-50%);opacity:0;pointer-events:none}.muzzle.show{animation:muzzle .13s ease-out}@keyframes muzzle{0%{opacity:1;transform:translate(-50%,-50%) scale(.6)}100%{opacity:0;transform:translate(-50%,-50%) scale(1.3)}}
.low-detail .smallfx{display:none}
.glooBtn{position:absolute;right:18px;bottom:222px;width:58px;height:58px;border-radius:50%;background:#245f7a;border:2px solid #b9efff;font-size:21px}
.glooBtn:active{transform:scale(.94)}
.glooWall{position:absolute;background:linear-gradient(135deg,#8be9ff,#2b6b91);border:2px solid #d7f7ff;border-radius:9px;box-shadow:0 4px 12px #0008}
.levelBadge{display:inline-block;background:#e4a900;color:#101820;border-radius:8px;padding:3px 7px;font-size:11px;font-weight:900}
.matchBanner{position:absolute;left:50%;top:18%;transform:translateX(-50%);padding:9px 16px;background:#101820dd;border:1px solid #596672;border-radius:10px;font-weight:900;display:none;z-index:15}
.matchBanner.show{display:block}
.voiceStatus{position:absolute;top:52px;right:12px;background:#101820dd;border:1px solid #46525d;border-radius:9px;padding:6px 9px;font-size:10px}
.micBtn,.emoteBtn{position:absolute;width:52px;height:52px;border-radius:50%;background:#202a34dd;border:1px solid #596672;pointer-events:auto}
.micBtn{right:18px;bottom:105px}.emoteBtn{right:82px;bottom:105px}
.emoteWheel{position:absolute;right:24px;bottom:168px;width:190px;height:190px;border-radius:50%;background:#0c1319ee;border:1px solid #56636e;display:none;pointer-events:auto}
.emoteWheel.show{display:block}
.emoteWheel button{position:absolute;width:48px;height:48px;border-radius:50%;padding:0;background:#27333d}
.emoteWheel button:nth-child(1){left:71px;top:8px}.emoteWheel button:nth-child(2){right:10px;top:72px}
.emoteWheel button:nth-child(3){right:25px;bottom:18px}.emoteWheel button:nth-child(4){left:71px;bottom:6px}
.emoteWheel button:nth-child(5){left:15px;bottom:22px}.emoteWheel button:nth-child(6){left:8px;top:72px}
.emoteBubble{position:absolute;left:50%;top:35%;transform:translateX(-50%);font-size:55px;display:none;pointer-events:none;text-shadow:0 3px 8px #000}
.emoteBubble.show{display:block;animation:emotePop .9s ease-out}@keyframes emotePop{0%{opacity:0;transform:translateX(-50%) scale(.5)}25%{opacity:1;transform:translateX(-50%) scale(1.1)}100%{opacity:0;transform:translateX(-50%) translateY(-35px) scale(1)}}
.friendRow{display:flex;align-items:center;justify-content:space-between;background:#1c2730;border:1px solid #394650;border-radius:10px;padding:11px;margin:7px 0;text-align:left}.onlineDot{display:inline-block;width:9px;height:9px;border-radius:50%;background:#21d36a;margin-right:6px}
.profileBig{font-size:22px;font-weight:900}.idBox{background:#1c2730;border:1px dashed #68747d;border-radius:10px;padding:14px;margin:10px 0;font-size:20px;letter-spacing:2px}
@media(max-width:600px){.brand{font-size:28px;left:18px;top:18px}.top{right:8px;top:8px}.pill{font-size:10px;padding:7px}.health{width:170px}.joystick{width:108px;height:108px}.knob{left:28px;top:28px;width:48px;height:48px}.mapgrid{grid-template-columns:1fr}}
</style>

<style id="harsh-splash-style">
#harshSplash{
  position:fixed;inset:0;z-index:99999;display:flex;align-items:center;justify-content:center;
  background:#05080b center/cover no-repeat;
  font-family:Arial,Helvetica,sans-serif;color:#fff;overflow:hidden;
}
#harshSplash:before{
  content:"";position:absolute;inset:0;background:linear-gradient(180deg,#02050855,#020508cc);
}
.splashBox{position:relative;text-align:center;padding:28px 34px;min-width:280px}
.splashBrand{
  font-size:clamp(28px,8vw,58px);font-weight:1000;letter-spacing:4px;
  text-shadow:0 4px 22px #000;animation:splashIn .7s ease both;
}
.splashSite{
  margin-top:10px;font-size:clamp(13px,3.5vw,20px);letter-spacing:3px;color:#ffd21a;
  font-weight:800;animation:splashIn .8s .15s ease both;
}
.splashFPS{
  margin-top:22px;font-size:clamp(20px,6vw,38px);font-weight:1000;letter-spacing:8px;
  opacity:0;animation:fpsIn .65s .65s ease forwards;
}
.splashLine{width:190px;height:3px;background:#ffd21a;margin:14px auto 0;transform:scaleX(0);animation:lineIn .55s 1s ease forwards}
.splashStart{
  margin-top:26px;padding:12px 38px;border:2px solid #ffd21a;border-radius:8px;
  background:#ffd21a;color:#101010;font-size:18px;font-weight:1000;letter-spacing:2px;
  opacity:0;animation:startIn .55s 1.35s ease forwards;
}
@keyframes splashIn{from{opacity:0;transform:translateY(18px) scale(.96)}to{opacity:1;transform:none}}
@keyframes fpsIn{from{opacity:0;transform:scale(.65)}to{opacity:1;transform:scale(1)}}
@keyframes lineIn{to{transform:scaleX(1)}}
@keyframes startIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
#harshSplash.hide{animation:splashOut .5s ease forwards}
@keyframes splashOut{to{opacity:0;visibility:hidden;transform:scale(1.03)}}
</style>

</head>
<body>

<div id="harshSplash" style="background-image:url(data:image/png;base6

  button class="splashStart" id="splashStart">START</button>
  </div>
</div>
<script id="harsh-splash-script">
(function(){
  const s=document.getElementById('harshSplash');
  const btn=document.getElementById('splashStart');
  function startGame(){
    if(!s || s.classList.contains('hide')) return;
    s.classList.add('hide');
    setTimeout(()=>s.remove(),550);
  }
  btn.addEventListener('click',startGame);
  setTimeout(startGame,3500);
})();
</script>


<section id="home" class="screen active">
<div class="hero"></div>
<div class="brand">STRIKE <span>OPS</span><div class="sub">LEGENDS ARENA • FPS</div></div>
<div class="top"><div class="pill" onclick="openFriends()">👥 Friends <span id="friendCount">2</span></div><div class="pill" onclick="openProfile()">🆔 7234567990</div></div>
<div class="menu">
<div class="card" style="background:#101820cc;border:1px solid #46525d;border-radius:12px;padding:10px 12px;margin-bottom:2px">
<b>🎮 STRIKE OPS</b><div class="small">Offline FPS Arena • Maps • Modes • Bots</div>
</div>
<button onclick="openModes()">▶ CHOOSE GAME MODE</button>
<button class="secondary" onclick="openMaps()">🗺️ CHOOSE MAP</button>
<button class="secondary" onclick="quickStart('Team Deathmatch')">⚔ QUICK TEAM DEATHMATCH</button>
<button class="secondary" onclick="quickStart('Deathmatch')">☠ QUICK DEATHMATCH</button>
<button class="secondary" onclick="quickStart('Survival')">💀 QUICK SURVIVAL</button>
<button class="secondary" onclick="openSettings()">⚙️ GRAPHICS / CONTROLS</button>
<button class="secondary" onclick="openSkins()">🎨 WEAPON SKINS</button>
<button class="secondary" onclick="openGlooCollection()">🧱 GLOO WALL COLLECTION</button>
<button class="secondary" onclick="openWeaponStats()">🔫 WEAPON ARSENAL</button>
<button class="secondary" onclick="openFriends()">👥 ONLINE FRIENDS</button>
<button class="secondary" onclick="openProfile()">🆔 PLAYER PROFILE</button>
</div>
</section>

<section id="game" class="screen">
<canvas id="world"></canvas>
<div id="landingOverlay" class="landingOverlay">
  <div class="plane">✈️</div>
  <div class="landingTitle">AIR DROP</div>
  <div class="landingText" id="landingText">Flying over the map...</div>
  <button onclick="jumpFromPlane()">🪂 JUMP</button>
</div>
<div class="hud">
<div class="status">🔫 <span id="mode">TEAM DEATHMATCH</span> • 🤖 OFFLINE BOTS</div>
<div class="mapname">🗺️ <span id="mapLabel">Desert Base</span> • ⏱️ <span id="matchTime">03:00</span></div>
<div class="score">BLUE <b id="blueScore">0</b> — <b id="redScore">0</b> RED • 💀 <b id="killScore">0</b> KILLS</div>
<div class="cross"></div><div id="muzzle" class="muzzle">✦</div>
<div id="voiceStatus" class="voiceStatus">🎙️ TEAM VOICE: OFF</div>
<button class="micBtn" onclick="toggleMic()">🎙️</button>
<button class="emoteBtn" onclick="toggleEmotes()">🕺</button>
<div id="emoteWheel" class="emoteWheel">
  <button onclick="useEmote('👋')">👋</button>
  <button onclick="useEmote('😂')">😂</button>
  <button onclick="useEmote('🔥')">🔥</button>
  <button onclick="useEmote('👍')">👍</button>
  <button onclick="useEmote('😎')">😎</button>
  <button onclick="useEmote('💃')">💃</button>
</div>
<div id="emoteBubble" class="emoteBubble"></div>
<div class="health"><div id="healthbar" class="healthbar"></div><div id="healthtext" class="healthtext">HP 100</div></div>
<div class="weapon">
<span id="weaponName">ASSAULT RIFLE</span><br>
<span class="ammo"><span id="ammo">30</span> / 120</span><br>
<span id="skinLabel" class="small">Classic Skin</span>
</div>
<div id="joystick" class="joystick"><div id="knob" class="knob"></div></div>
<button class="reload" onclick="reloadWeapon()">↻</button>
<button class="switch" onclick="switchWeapon()">⇄</button>
<button class="fire" onclick="shoot()">FIRE</button>
<button class="glooBtn" onclick="placeGlooWall()">🧱</button>
<button id="aimBtn" class="switch" style="right:194px;bottom:151px" onclick="toggleAim()">🎯</button>
</div>
</section>

<div id="setup" class="modal"><div class="panel" id="setupPanel"></div></div>
<div id="result" class="modal"><div class="panel">
<h2 id="resultTitle">🏆 MATCH RESULT</h2>
<h1><span id="finalBlue">0</span> - <span id="finalRed">0</span></h1>
<p>Kills: <b id="finalKills">0</b></p>
<p>Mode: <b id="finalMode">TEAM DEATHMATCH</b></p>
<p>Map: <b id="finalMap">Desert Base</b></p>
<button onclick="backHome()">BACK TO HOME</button>
</div></div>

<script>
const canvas=document.getElementById('world'),ctx=canvas.getContext('2d');
let W=innerWidth,H=innerHeight,gameRunning=false,blue=0,red=0,kills=0,hp=100,ammo=30,weaponIndex=0,selectedMap=0,selectedMode='Team Deathmatch';
let player={x:0,y:0,speed:3},bots=[],matchTimer=0;
const maps=[
{name:'Desert Base',type:'desert',desc:'Open base, roads and cover'},
{name:'City Strike',type:'city',desc:'Buildings, alleys and streets'},
{name:'Forest Camp',type:'forest',desc:'Trees, rocks and open ground'},
{name:'Snow Outpost',type:'snow',desc:'Cold base with long sightlines'}
];
const weapons=[
{name:'ASSAULT RIFLE',ammo:30,damage:25},
{name:'SMG',ammo:40,damage:15},
{name:'SHOTGUN',ammo:8,damage:45},
{name:'SNIPER',ammo:5,damage:80},
{name:'PISTOL',ammo:12,damage:30}
];

let aimMode=false;
let graphicsQuality='Medium';
let controlMode='Touch';
let selectedSkin=0;
const skins=[
 {name:'Classic',label:'Classic Skin',a:'#39aaff',b:'#e84646'},
 {name:'Gold',label:'Gold Skin',a:'#ffd34a',b:'#d89b00'},
 {name:'Shadow',label:'Shadow Skin',a:'#9aa0a6',b:'#30343a'},
 {name:'Neon',label:'Neon Skin',a:'#5cffd0',b:'#ff4fd8'}
];

function toggleAim(){
 aimMode=!aimMode;
 document.getElementById('game').classList.toggle('aiming',aimMode);
 document.getElementById('aimBtn').textContent=aimMode?'🎯 ON':'🎯';
}
function applySkin(i){
 selectedSkin=i;
 document.getElementById('skinLabel').textContent=skins[i].label;
 closeSetup();
}
function openWeaponStats(){
 const cards=weapons.map((w,i)=>`<div class="card"><b>${i+1}. ${w.name}</b><br><span class="small">Magazine: ${w.ammo} • Damage: ${w.damage} • ${i===0?'Balanced':i===1?'Fast fire':i===2?'Close range':i===3?'Long range':'Sidearm'}</span></div>`).join('');
 document.getElementById('setupPanel').innerHTML=`<h2>🔫 Weapon Arsenal</h2>${cards}<button onclick="closeSetup()">CLOSE</button>`;
 document.getElementById('setup').classList.add('show');
}
function openSkins(){
 let cards=skins.map((s,i)=>`
 <div class="card" onclick="applySkin(${i})">
 <span class="skin-dot" style="background:${s.a}"></span><b>${s.name}</b>
 <div class="small">${s.label}</div>
 </div>`).join('');
 document.getElementById('setupPanel').innerHTML=
 `<h2>🎨 Weapon Skins</h2>${cards}<button onclick="closeSetup()">CLOSE</button>`;
 document.getElementById('setup').classList.add('show');
}
function openSettings(){
 document.getElementById('setupPanel').innerHTML=`
 <h2>⚙️ Graphics / Controls</h2>
 <div class="settings-row"><b>Graphics</b>
 <select id="graphicsSelect" onchange="setGraphics(this.value)">
 <option>Low</option><option selected>Medium</option><option>High</option>
 </select></div>
 <div class="settings-row"><b>Controls</b>
 <select id="controlsSelect" onchange="setControls(this.value)">
 <option selected>Touch</option><option>Keyboard</option>
 </select></div>
 <div class="settings-row"><b>Aim Assist</b>
 <button onclick="toggleAim()">🎯 Toggle Aim</button></div>
 <button onclick="closeSetup()">SAVE & CLOSE</button>`;
 document.getElementById('setup').classList.add('show');
}
function setGraphics(v){
 graphicsQuality=v;
 document.body.classList.toggle('lowgfx',v==='Low');
 optimizeLowEnd();
}
function setControls(v){
 controlMode=v;
 document.getElementById('joystick').style.display=v==='Keyboard'?'none':'block';
}


let landingActive=false;
let landed=false;
let audioCtx=null;

function initAudio(){
  if(!audioCtx){
    const AC=window.AudioContext||window.webkitAudioContext;
    if(AC) audioCtx=new AC();
  }
  if(audioCtx && audioCtx.state==='suspended') audioCtx.resume();
}
function beep(freq,duration,type='square',volume=.035){
  initAudio();
  if(!audioCtx)return;
  const o=audioCtx.createOscillator(),g=audioCtx.createGain();
  o.type=type;o.frequency.value=freq;g.gain.value=volume;
  o.connect(g);g.connect(audioCtx.destination);
  o.start();g.gain.exponentialRampToValueAtTime(.001,audioCtx.currentTime+duration);o.stop(audioCtx.currentTime+duration);
}
function gunSound(){
  beep(95,.055,'sawtooth',.07);
  setTimeout(()=>beep(55,.045,'square',.035),20);
}
function reloadSound(){beep(420,.07,'sine',.035);setTimeout(()=>beep(620,.08,'sine',.035),90)}
function showMuzzle(){const m=document.getElementById('muzzle');m.classList.remove('show');void m.offsetWidth;m.classList.add('show')}
function optimizeLowEnd(){
  if(graphicsQuality==='Low'){
    document.body.classList.add('low-detail');
    canvas.style.imageRendering='pixelated';
  }else{
    document.body.classList.remove('low-detail');
    canvas.style.imageRendering='auto';
  }
}
function beginLanding(){
  landingActive=true;landed=false;
  document.getElementById('landingOverlay').classList.add('show');
  document.getElementById('landingText').textContent='Flying over '+maps[selectedMap].name+'...';
}
function jumpFromPlane(){
  if(!landingActive)return;
  const overlay=document.getElementById('landingOverlay');
  overlay.querySelector('.plane').textContent='🪂';
  document.getElementById('landingText').textContent='Parachute deployed • Landing...';
  beep(260,.12,'sine',.04);
  setTimeout(()=>{
    landingActive=false;landed=true;
    overlay.classList.remove('show');
    beep(620,.08,'sine',.04);
  },1100);
}


let micOn=false;
let emotesOpen=false;
let friends=[
 {name:'SkullHunter',id:'72839102',online:true,accepted:true},
 {name:'DarkKiller',id:'88321044',online:true,accepted:true},
 {name:'NightWolf',id:'56120487',online:false,accepted:false}
];

function toggleMic(){
  micOn=!micOn;
  document.getElementById('voiceStatus').textContent=micOn?'🎙️ TEAM VOICE: ON':'🎙️ TEAM VOICE: OFF';
  beep(micOn?720:320,.08,'sine',.03);
}
function toggleEmotes(){
  emotesOpen=!emotesOpen;
  document.getElementById('emoteWheel').classList.toggle('show',emotesOpen);
}
function useEmote(icon){
  emotesOpen=false;
  document.getElementById('emoteWheel').classList.remove('show');
  const b=document.getElementById('emoteBubble');
  b.textContent=icon;b.classList.remove('show');void b.offsetWidth;b.classList.add('show');
  beep(520,.07,'sine',.025);
}
function openFriends(){
  const rows=friends.map((f,i)=>`
   <div class="friendRow">
    <div><span class="onlineDot" style="background:${f.online?'#21d36a':'#68737c'}"></span><b>${f.name}</b><br><span class="small">ID: ${f.id} • ${f.online?'Online':'Offline'}</span></div>
    <button onclick="friendAction(${i})">${f.accepted?'REMOVE':'ACCEPT'}</button>
   </div>`).join('');
  document.getElementById('setupPanel').innerHTML=`<h2>👥 Online Friends</h2>${rows}<button onclick="closeSetup()">CLOSE</button>`;
  document.getElementById('setup').classList.add('show');
}
function friendAction(i){
  friends[i].accepted=!friends[i].accepted;
  if(!friends[i].accepted) friends[i].online=false;
  document.getElementById('friendCount').textContent=friends.filter(f=>f.accepted).length;
  openFriends();
}
function openProfile(){
  document.getElementById('setupPanel').innerHTML=`
   <h2>🆔 Player Profile</h2>
   <div class="idBox">7234567990</div>
   <div class="profileBig">LegendWarrior</div>
   <div class="card">⭐ Level 1<br>🏆 Wins: 0<br>💀 Kills: <span id="profileKills">0</span><br>👥 Friends: <span id="profileFriends">2</span></div>
   <button onclick="copyPlayerId()">📋 COPY PLAYER ID</button>
   <button onclick="closeSetup()">CLOSE</button>`;
  document.getElementById('setup').classList.add('show');
}
function copyPlayerId(){
  if(navigator.clipboard)navigator.clipboard.writeText('7234567990');
  beep(760,.06,'sine',.025);
}


let playerLevel=1;
let glooCount=3;
let glooWalls=[];
let matchSeconds=180;
let matchClock=null;
let currentWeaponFire=0;

const glooSkins=[
 {level:1,name:'Starter Shield',a:'#8be9ff',b:'#2b6b91'},
 {level:5,name:'Crimson Guard',a:'#ff6b63',b:'#7d1f27'},
 {level:10,name:'Neon Fortress',a:'#64ffd6',b:'#167a68'},
 {level:15,name:'Royal Ice',a:'#d6f3ff',b:'#587aa0'},
 {level:20,name:'Shadow Core',a:'#8f98a2',b:'#262b31'}
];

function unlockedGlooSkins(){
 return glooSkins.map((s,i)=>({...s,unlocked:playerLevel>=s.level}));
}
function currentGlooSkin(){
 let available=unlockedGlooSkins().filter(s=>s.unlocked);
 return available[available.length-1]||glooSkins[0];
}
function placeGlooWall(){
 if(!gameRunning||landingActive||glooCount<=0)return;
 const s=currentGlooSkin();
 const wall={x:player.x+26,y:player.y-42,w:82,h:12,a:s.a,b:s.b};
 glooWalls.push(wall);glooCount--;beep(190,.08,'sine',.04);updateHUD();
}
function drawGlooWalls(){
 glooWalls.forEach(w=>{
  const grad=ctx.createLinearGradient(w.x,w.y,w.x+w.w,w.y+w.h);
  grad.addColorStop(0,w.a);grad.addColorStop(1,w.b);
  ctx.fillStyle=grad;ctx.fillRect(w.x,w.y,w.w,w.h);
  ctx.strokeStyle='#eaffff';ctx.lineWidth=2;ctx.strokeRect(w.x,w.y,w.w,w.h);
  ctx.fillStyle='#ffffffaa';ctx.fillRect(w.x+8,w.y+3,w.w-16,2);
 });
}
function openGlooCollection(){
 const cards=glooSkins.map(s=>`
  <div class="card">
   <b>${s.name}</b><br><span class="small">Unlocks at Level ${s.level}</span>
   <span class="levelBadge">${playerLevel>=s.level?'UNLOCKED':'🔒 LOCKED'}</span>
  </div>`).join('');
 document.getElementById('setupPanel').innerHTML=`
  <h2>🧱 Gloo Wall Collection</h2>
  <div class="card"><b>Current Level: ${playerLevel}</b><br>New wall designs unlock as you level up.</div>
  ${cards}<button onclick="closeSetup()">CLOSE</button>`;
 document.getElementById('setup').classList.add('show');
}
function addXP(amount){
 playerLevel=Math.max(1,Math.min(50,playerLevel+Math.floor(amount/100)));
}
function startMatchClock(){
 clearInterval(matchClock);matchSeconds=180;updateTimer();
 matchClock=setInterval(()=>{
  if(!gameRunning||landingActive)return;
  matchSeconds--;updateTimer();
  if(matchSeconds<=0)endGame();
 },1000);
}
function updateTimer(){
 const m=String(Math.floor(matchSeconds/60)).padStart(2,'0');
 const s=String(matchSeconds%60).padStart(2,'0');
 const el=document.getElementById('matchTime');if(el)el.textContent=m+':'+s;
}
function endGame(){
 if(!gameRunning)return;
 gameRunning=false;clearInterval(matchClock);
 document.getElementById('finalBlue').textContent=blue;
 document.getElementById('finalRed').textContent=red;
 document.getElementById('finalKills').textContent=kills;
 document.getElementById('finalMode').textContent=selectedMode;
 document.getElementById('finalMap').textContent=maps[selectedMap].name;
 addXP(kills*100);
 document.getElementById('resultTitle').textContent=blue>=red?'🏆 VICTORY':'💀 DEFEAT';
 document.getElementById('result').classList.add('show');
}

function resize(){W=innerWidth;H=innerHeight;canvas.width=W;canvas.height=H}
addEventListener('resize',resize);resize();
document.addEventListener('pointerdown',initAudio,{once:true});

function openModes(){
 document.getElementById('setupPanel').innerHTML=`
 <h2>🎮 Choose Game Mode</h2>
 <div class="card" onclick="selectMode('Team Deathmatch')">👥 <b>Team Deathmatch</b><span class="small">Blue vs Red • Target 10</span></div>
 <div class="card" onclick="selectMode('Deathmatch')">☠ <b>Deathmatch</b><span class="small">Free-for-all combat</span></div>
 <div class="card" onclick="selectMode('Survival')">💀 <b>Survival</b><span class="small">Survive waves of offline bots</span></div>
 <button onclick="closeSetup()">CLOSE</button>`;
 document.getElementById('setup').classList.add('show');
}
function selectMode(mode){selectedMode=mode;closeSetup();openMaps()}
function openMaps(){
 let cards=maps.map((m,i)=>`<div class="mapcard ${i===selectedMap?'active':''}" onclick="selectMap(${i})"><b>🗺️ ${m.name}</b><span class="small">${m.desc}</span></div>`).join('');
 document.getElementById('setupPanel').innerHTML=`<h2>🗺️ Choose Map</h2><div class="mapgrid">${cards}</div><button onclick="startGame()">▶ START ${selectedMode.toUpperCase()}</button><button onclick="closeSetup()">CLOSE</button>`;
 document.getElementById('setup').classList.add('show');
}
function selectMap(i){selectedMap=i;openMaps()}
function closeSetup(){document.getElementById('setup').classList.remove('show')}
function quickStart(mode){selectedMode=mode;startGame()}
function startGame(){
 closeSetup();
 document.getElementById('home').classList.remove('active');
 document.getElementById('game').classList.add('active');
 document.getElementById('mode').textContent=selectedMode.toUpperCase();
 document.getElementById('mapLabel').textContent=maps[selectedMap].name;
 blue=red=kills=0;hp=100;weaponIndex=0;ammo=weapons[0].ammo;matchTimer=0;aimMode=false;glooCount=3;glooWalls=[];
document.getElementById('game').classList.remove('aiming');
document.getElementById('skinLabel').textContent=skins[selectedSkin].label;
document.getElementById('aimBtn').textContent='🎯';
 player.x=W/2;player.y=H/2;spawnBots();updateHUD();optimizeLowEnd();gameRunning=true;initAudio();beginLanding();startMatchClock();requestAnimationFrame(loop);
}
function spawnBots(){
 bots=[];
 const count=selectedMode==='Survival'?10:8;
 for(let i=0;i<count;i++)bots.push({x:Math.random()*W,y:Math.random()*H,team:i%2,hp:100,s:.35+Math.random()*.5,t:30+Math.random()*80,kills:0});
}
function drawWorld(){
 const m=maps[selectedMap];
 if(m.type==='desert')ctx.fillStyle='#4c5550';
 if(m.type==='city')ctx.fillStyle='#39434a';
 if(m.type==='forest')ctx.fillStyle='#354a3b';
 if(m.type==='snow')ctx.fillStyle='#7c898e';
 ctx.fillRect(0,0,W,H);
 ctx.fillStyle=m.type==='snow'?'#9aa3a3':m.type==='forest'?'#56664e':'#626b64';
 ctx.fillRect(0,H*.56,W,H*.44);
 ctx.fillStyle=m.type==='city'?'#303638':'#343a39';ctx.fillRect(0,H*.65,W,58);ctx.fillRect(W*.45,0,70,H);
 for(let i=0;i<9;i++){
   const x=i*W/9,bh=90+(i%4)*32;
   ctx.fillStyle=m.type==='city'?(i%2?'#20282d':'#2d373b'):m.type==='snow'?'#59646a':m.type==='forest'?'#263c2c':'#30393c';
   ctx.fillRect(x,H*.43-bh,92,bh);
 }
 for(let i=0;i<8;i++){
   const x=55+i*135,y=H*.58;
   ctx.fillStyle=m.type==='forest'?'#253b29':m.type==='snow'?'#667278':'#68716b';
   ctx.fillRect(x,y,68,30);
 }
 if(m.type==='forest'){
   for(let i=0;i<18;i++){ctx.fillStyle='#18341f';ctx.beginPath();ctx.arc((i*97)%W,(i*61)%H,18,0,Math.PI*2);ctx.fill()}
 }
}
function drawPlayer(){
 ctx.fillStyle=skins[selectedSkin].a;ctx.beginPath();ctx.arc(player.x,player.y,15,0,Math.PI*2);ctx.fill();
 ctx.strokeStyle='#fff';ctx.stroke();
}
function drawBots(){
 bots.forEach(b=>{
   ctx.fillStyle=b.team===0?skins[selectedSkin].a:skins[selectedSkin].b;ctx.fillRect(b.x-12,b.y-12,24,24);
   ctx.fillStyle='#111';ctx.fillRect(b.x-18,b.y-25,36,5);
   ctx.fillStyle='#27d05a';ctx.fillRect(b.x-18,b.y-25,36*(b.hp/100),5);
 });
}
function updateBots(){
 bots.forEach(b=>{
   const dx=player.x-b.x,dy=player.y-b.y,d=Math.hypot(dx,dy)||1;
   if(d>95){b.x+=dx/d*b.s;b.y+=dy/d*b.s}
   else if(--b.t<=0){b.t=60+Math.random()*100;if(b.team===1&&Math.random()<.28)damagePlayer(5+Math.random()*8)}
 });
}
function nearestEnemy(){
 let n=null,dist=Infinity;
 bots.forEach(b=>{
   const hostile=selectedMode==='Team Deathmatch'?b.team!==0:true;
   if(!hostile)return;
   const d=Math.hypot(player.x-b.x,player.y-b.y);
   const maxRange=aimMode?Math.min(W,H)*0.75:Math.min(W,H)*0.45;
   if(d<dist && d<=maxRange){dist=d;n=b}
 });
 return n;
}
function shoot(){
 if(!gameRunning || landingActive)return;
 if(ammo<=0){reloadWeapon();return}
 ammo--;gunSound();showMuzzle();
 const fireDelay=[160,95,360,700,220][weaponIndex];
 const now=Date.now();if(now-currentWeaponFire<fireDelay)return;currentWeaponFire=now;
 const b=nearestEnemy();
 if(b){
   b.hp-=weapons[weaponIndex].damage;
   if(b.hp<=0){
     kills++;blue++;
     b.x=Math.random()*W;b.y=Math.random()*H;b.hp=100;b.kills++;
     if(selectedMode==='Deathmatch'&&blue>=10)endGame();
     if(selectedMode==='Team Deathmatch'&&blue>=10)endGame();
   }
 }
 updateHUD();
}
function damagePlayer(n){
 if(!gameRunning || landingActive)return;
 hp=Math.max(0,hp-n);red++;
 updateHUD();
 if(hp===0)setTimeout(respawn,450);
 if(selectedMode==='Survival'&&red>=15)endGame();
}
function respawn(){if(!gameRunning)return;hp=100;player.x=30+Math.random()*(W-60);player.y=30+Math.random()*(H-60);updateHUD()}
function reloadWeapon(){reloadSound();ammo=weapons[weaponIndex].ammo;updateHUD()}
function switchWeapon(){weaponIndex=(weaponIndex+1)%weapons.length;ammo=weapons[weaponIndex].ammo;updateHUD()}
function updateHUD(){
 document.getElementById('blueScore').textContent=blue;
 document.getElementById('redScore').textContent=red;
 document.getElementById('killScore').textContent=kills;
 const pk=document.getElementById('profileKills'); if(pk)pk.textContent=kills;
 const pf=document.getElementById('profileFriends'); if(pf)pf.textContent=friends.filter(f=>f.accepted).length;
 document.getElementById('ammo').textContent=ammo;
 const gl=document.getElementById('glooLabel');if(gl)gl.textContent='🧱 Gloo: '+glooCount;
 document.getElementById('weaponName').textContent=weapons[weaponIndex].name;
 document.getElementById('healthbar').style.width=hp+'%';
 document.getElementById('healthtext').textContent='HP '+Math.round(hp);
}
function loop(){if(!gameRunning)return;drawWorld();drawGlooWalls();updateBots();drawBots();drawPlayer();requestAnimationFrame(loop)}

function backHome(){
 clearInterval(matchClock);landingActive=false;
 document.getElementById('landingOverlay').classList.remove('show');
 document.getElementById('result').classList.remove('show');
 document.getElementById('game').classList.remove('active');
 document.getElementById('home').classList.add('active');
}
function showInfo(){
 document.getElementById('setupPanel').innerHTML=`<h2>👥 Online Friends</h2><div class="card">🟢 SkullHunter — Online<br>ID: 72839102</div><div class="card">🟢 DarkKiller — In Match<br>ID: 88321044</div><button onclick="closeSetup()">CLOSE</button>`;
 document.getElementById('setup').classList.add('show');
}
const joy=document.getElementById('joystick'),knob=document.getElementById('knob');let active=false;
joy.addEventListener('pointerdown',e=>{active=true;joy.setPointerCapture(e.pointerId);moveJoy(e)});
joy.addEventListener('pointermove',e=>{if(active)moveJoy(e)});
joy.addEventListener('pointerup',resetJoy);joy.addEventListener('pointercancel',resetJoy);
function moveJoy(e){
 const r=joy.getBoundingClientRect(),cx=r.width/2,cy=r.height/2;let x=e.clientX-r.left-cx,y=e.clientY-r.top-cy;
 const max=34,d=Math.hypot(x,y)||1;if(d>max){x=x/d*max;y=y/d*max}
 knob.style.transform=`translate(${x}px,${y}px)`;
 if(gameRunning){player.x+=x/max*player.speed;player.y+=y/max*player.speed;player.x=Math.max(18,Math.min(W-18,player.x));player.y=Math.max(18,Math.min(H-18,player.y))}
}
function resetJoy(){active=false;knob.style.transform='translate(0,0)'}
document.addEventListener('keydown',e=>{
 if(!gameRunning)return;
 if(e.key==='w')player.y-=player.speed*3;if(e.key==='s')player.y+=player.speed*3;if(e.key==='a')player.x-=player.speed*3;if(e.key==='d')player.x+=player.speed*3;
 if(e.key==='r')reloadWeapon();if(e.key===' ')shoot();
});
</script>
</body>
</html>
